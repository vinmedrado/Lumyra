# Lumyra — Modern Event Operations Platform
APP_ENV=development
APP_NAME=Lumyra
APP_VERSION=1.0.0
DEMO_MODE=true

# SQLite local by default. Use PostgreSQL for production.
DATABASE_URL=sqlite:///data/event_erp.sqlite3
# DATABASE_URL=postgresql+psycopg2://lumyra:lumyra@postgres:5432/lumyra

SECRET_KEY=change-me-with-a-long-random-value
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

STORAGE_PATH=storage
LOG_LEVEL=INFO
WHATSAPP_PROVIDER=demo
API_BASE_URL=http://localhost:8000

DEFAULT_TENANT_NAME=Lumyra Demo Events
DEFAULT_TENANT_SLUG=lumyra-demo
ADMIN_EMAIL=admin@lumyra.demo
ADMIN_PASSWORD=admin123

WORKER_ID=lumyra-worker-1
SCHEDULER_LOCK_SECONDS=60

# Frontend / realtime
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
REALTIME_ENABLED=true
WEBSOCKET_PATH=/ws
